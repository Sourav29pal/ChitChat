# Server Configuration
PORT=4001
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chatapp?retryWrites=true&w=majority

# JWT Secret (REQUIRED - Server will not start without this set)
JWT_SECRET=your_secure_jwt_secret_here

# Redis Configuration (Optional for single-node local dev, REQUIRED for multi-instance scaling & presence)
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# PRESENCE_TTL_SECONDS=60

# Cloudinary Storage Configuration (REQUIRED for image attachments and profile picture uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional WebRTC TURN Relay Server Configuration
# STUN is used by default. Configure TURN only if direct peer-to-peer
# connectivity fails on restrictive networks or NATs.
# Option A: Full ICE_SERVERS JSON array
# ICE_SERVERS='[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.yourdomain.com:3478?transport=udp","turn:turn.yourdomain.com:3478?transport=tcp","turns:turn.yourdomain.com:443?transport=tcp"],"username":"turn_user","credential":"turn_password"}]'
# Option B: Individual TURN variables
# TURN_URL=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp,turns:turn.yourdomain.com:443?transport=tcp
# TURN_USERNAME=your_turn_username
# TURN_PASSWORD=your_turn_password
# Option C: Metered.ca TURN API integration
# METERED_DOMAIN=your_app_domain
# METERED_API_KEY=your_metered_api_key
